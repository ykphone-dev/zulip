{{! The Later page's "Set due date" menu (the 옆커폰 fork): round 13's reminder presets, a custom time and, when a date is set, "Remove due date". }}
<div class="popover-menu ykphone-due-menu" data-simplebar data-simplebar-tab-index="-1">
    <ul role="menu" class="popover-menu-list">
        {{#each presets}}
        <li role="none" class="link-item popover-menu-list-item">
            <a role="menuitem" class="ykphone-due-preset popover-menu-link" data-ykphone-preset="{{id}}" tabindex="0">
                <span class="popover-menu-label">{{text}}</span>
            </a>
        </li>
        {{/each}}
        <li role="none" class="link-item popover-menu-list-item">
            <a role="menuitem" class="ykphone-due-custom popover-menu-link" tabindex="0">
                <span class="popover-menu-label">{{t "Custom time" }}</span>
            </a>
        </li>
        {{#if has_due}}
        <li role="none" class="link-item popover-menu-list-item">
            <a role="menuitem" class="ykphone-due-remove popover-menu-link" tabindex="0">
                <span class="popover-menu-label">{{t "Remove due date" }}</span>
            </a>
        </li>
        {{/if}}
    </ul>
</div>
