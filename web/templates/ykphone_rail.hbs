{{! Icon rail at the left edge of the app; the logo is moved in from the navbar by ykphone_rail.ts. }}
<nav
  id="ykphone-rail"
  class="ykphone-rail"
  aria-label="{{t 'Main navigation'}}"
  >
    <div class="ykphone-rail-logo"></div>
    <ul class="ykphone-rail-items hidden-for-spectators">
        {{#each items}}
            <li>
                <a
                  class="ykphone-rail-item auto-hide-left-sidebar-overlay"
                  href="{{href}}"
                  data-rail-item="{{id}}"
                  >
                    {{! The tile holds the glyph (outline, or its filled twin while active) and the badge; the label sits under it. }}
                    <span class="ykphone-rail-tile">
                        <i
                          class="zulip-icon zulip-icon-{{icon}} ykphone-rail-glyph ykphone-rail-glyph-outline"
                          aria-hidden="true"
                          ></i>
                        <i
                          class="zulip-icon zulip-icon-{{filled_icon}} ykphone-rail-glyph ykphone-rail-glyph-filled"
                          aria-hidden="true"
                          ></i>
                        {{! Unread count, filled in by ykphone_unread_badges; hidden while empty. }}
                        <span class="ykphone-rail-badge" aria-hidden="true"></span>
                    </span>
                    <span class="ykphone-rail-label">{{label}}</span>
                </a>
            </li>
        {{/each}}
    </ul>
    <div class="ykphone-rail-bottom hidden-for-spectators">
        <button
          type="button"
          id="ykphone-rail-avatar"
          class="ykphone-rail-avatar"
          aria-label="{{t 'Personal menu'}}"
          >
            <img
              class="ykphone-rail-avatar-image header-button-avatar-image"
              src="{{avatar_url}}"
              alt=""
              />
            <span class="ykphone-rail-pause-badge" aria-hidden="true" hidden>z</span>
            {{#if user_circle_class}}
            <span
              class="zulip-icon zulip-icon-{{user_circle_class}} {{user_circle_class}} user-circle ykphone-rail-presence"
              data-presence-indicator-user-id="{{my_user_id}}"
              ></span>
            {{/if}}
        </button>
    </div>
</nav>
