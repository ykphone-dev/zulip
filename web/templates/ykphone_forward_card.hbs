{{! The message being forwarded, shown above the compose box; the note the user adds goes in the box itself. }}
<div
    id="ykphone-forward-card"
    class="ykphone-forward-card"
    data-message-id="{{message_id}}"
>
    <div class="ykphone-forward-card-header">
        <i class="zulip-icon zulip-icon-forward-message" aria-hidden="true"></i>
        <span class="ykphone-forward-card-label">{{t
                "Forwarding this message"
            }}</span>
        <button
            type="button"
            class="ykphone-forward-card-close"
            aria-label="{{t 'Cancel forwarding'}}"
            data-tippy-content="{{t 'Cancel forwarding'}}"
        >
            <i class="zulip-icon zulip-icon-close" aria-hidden="true"></i>
        </button>
    </div>
    <div class="ykphone-forward-card-message">
        <img
            class="ykphone-forward-card-avatar"
            src="{{avatar_url}}"
            alt=""
            loading="lazy"
        />
        <div class="ykphone-forward-card-body">
            <div class="ykphone-forward-card-sender">
                <span
                    class="ykphone-forward-card-sender-name"
                >{{sender_name}}</span>
                <span class="ykphone-forward-card-time">{{time_label}}</span>
            </div>
            <div
                class="ykphone-forward-card-content rendered_markdown"
            >{{rendered_markdown content}}</div>
        </div>
    </div>
</div>