{{! History controls at the left of the top bar: back, forward and the History dropdown. }}
<div class="ykphone-navbar-history">
    <button type="button" class="header-button ykphone-navbar-back tippy-zulip-tooltip" aria-label="{{t 'Back' }}" data-tippy-content="{{t 'Back' }}">
        <i class="zulip-icon zulip-icon-arrow-left" aria-hidden="true"></i>
    </button>
    <button type="button" class="header-button ykphone-navbar-forward tippy-zulip-tooltip" aria-label="{{t 'Forward' }}" data-tippy-content="{{t 'Forward' }}">
        <i class="zulip-icon zulip-icon-arrow-left ykphone-navbar-forward-icon" aria-hidden="true"></i>
    </button>
    {{! The tooltip is on the icon: a button that holds a tooltip of its own cannot also open a popover menu (popover_menus.toggle_popover_menu). }}
    <button type="button" class="header-button ykphone-navbar-history-menu" aria-label="{{t 'History' }}" aria-haspopup="menu">
        <i class="zulip-icon zulip-icon-clock tippy-zulip-tooltip" aria-hidden="true" data-tippy-content="{{t 'History' }}"></i>
    </button>
</div>
