{{! History controls at the left of the top bar: back, forward and the Threads view. }}
<div class="ykphone-navbar-history">
    <button type="button" class="header-button ykphone-navbar-back tippy-zulip-tooltip" aria-label="{{t 'Back' }}" data-tippy-content="{{t 'Back' }}">
        <i class="zulip-icon zulip-icon-arrow-left" aria-hidden="true"></i>
    </button>
    <button type="button" class="header-button ykphone-navbar-forward tippy-zulip-tooltip" aria-label="{{t 'Forward' }}" data-tippy-content="{{t 'Forward' }}">
        <i class="zulip-icon zulip-icon-arrow-left ykphone-navbar-forward-icon" aria-hidden="true"></i>
    </button>
    <a class="header-button ykphone-navbar-recent tippy-zulip-tooltip" href="#recent" aria-label="{{t 'Threads' }}" data-tippy-content="{{t 'Threads' }}">
        <i class="zulip-icon zulip-icon-clock" aria-hidden="true"></i>
    </a>
</div>
