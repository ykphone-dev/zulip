{{! The rich composer's bubble for the link the cursor is in. }}
<div class="ykphone-rich-link-bubble">
    <span class="ykphone-rich-link-bubble-url" title="{{href}}">{{href}}</span>
    <button
        type="button"
        class="ykphone-rich-link-bubble-button ykphone-rich-link-open"
    >{{t "Open"}}</button>
    <button
        type="button"
        class="ykphone-rich-link-bubble-button ykphone-rich-link-edit"
    >{{t "Edit"}}</button>
    <button
        type="button"
        class="ykphone-rich-link-bubble-button ykphone-rich-link-drop"
    >{{t "Remove link"}}</button>
</div>