{{! The Activity feed: one row per message, or the loading, empty and error states. }}
{{#if loading}}
<div class="ykphone-activity-status">{{t 'Loading…' }}</div>
{{else if error}}
<div class="ykphone-activity-status ykphone-activity-error">{{t 'Could not load your activity.' }}</div>
{{else if has_rows}}
<ul class="ykphone-activity-list">
    {{#each rows}}
        <li class="ykphone-activity-item">
            <a class="ykphone-activity-row" href="{{url}}" data-message-id="{{message_id}}">
                <img class="ykphone-activity-avatar" src="{{avatar_url}}" alt="" loading="lazy" />
                <span class="ykphone-activity-main">
                    <span class="ykphone-activity-meta">
                        <span class="ykphone-activity-sender">{{sender_name}}</span>
                        <span class="ykphone-activity-context">{{context_label}}</span>
                    </span>
                    <span class="ykphone-activity-snippet">{{snippet}}</span>
                </span>
                <span class="ykphone-activity-time">{{time_label}}</span>
            </a>
        </li>
    {{/each}}
</ul>
{{else}}
<div class="ykphone-activity-status">{{t 'No activity yet.' }}</div>
{{/if}}
