{{! Rows of the Activity page: one per item, or the loading, empty and error states. }}
{{#if loading}}
<div class="ykphone-split-status">{{t 'Loading…' }}</div>
{{else if error}}
<div class="ykphone-split-status ykphone-split-error">{{t 'Could not load your activity.' }}</div>
{{else if has_rows}}
<ul class="ykphone-split-rows">
    {{#each rows}}
        <li class="ykphone-split-item">
            <a class="ykphone-split-row ykphone-split-activity-row{{#if is_active}} active{{/if}}{{#if is_unread}} unread{{/if}}" href="{{url}}" data-message-id="{{message_id}}" {{#if is_active}}aria-current="page"{{/if}}>
                <span class="ykphone-split-avatar-cell">
                    <img class="ykphone-split-avatar" src="{{avatar_url}}" alt="" loading="lazy" />
                </span>
                <span class="ykphone-split-main">
                    <span class="ykphone-split-meta">
                        <span class="ykphone-split-activity-line">{{line}}</span>
                        <span class="ykphone-split-time">{{time_label}}</span>
                    </span>
                    <span class="ykphone-split-line">
                        <span class="ykphone-split-snippet">{{snippet}}</span>
                        {{#if is_unread}}
                        <span class="ykphone-split-dot" aria-label="{{t 'Unread' }}"></span>
                        {{/if}}
                    </span>
                </span>
            </a>
        </li>
    {{/each}}
</ul>
{{else}}
<div class="ykphone-split-status">{{empty_label}}</div>
{{/if}}
