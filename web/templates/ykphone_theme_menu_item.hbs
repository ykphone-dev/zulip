{{! Opens the theme picker in Settings → Preferences from the personal
menu; the hash change closes the menu. }}
<li role="none" class="link-item hidden-for-spectators popover-menu-list-item">
    <a role="menuitem" href="#settings/preferences" class="ykphone-open-theme-picker navigate-link-on-enter popover-menu-link" tabindex="0">
        <i class="popover-menu-icon zulip-icon zulip-icon-ykphone-palette" aria-hidden="true"></i>
        <span class="popover-menu-label">{{t "Theme…" }}</span>
    </a>
</li>
