{{! The list column of the split pages (DM, Activity, Threads, search, Drafts & sent, Later, unreads) (ykphone_split_view_ui); the rows and the search header are rendered separately into their containers. }}
<div class="ykphone-split-list-card">
    <div class="ykphone-split-list-header">
        <h2 class="ykphone-split-list-title">{{title}}</h2>
    </div>
    {{#if is_search}}
    <div class="ykphone-search-query">
        <i class="zulip-icon zulip-icon-search ykphone-search-query-icon" aria-hidden="true"></i>
        <span class="ykphone-search-query-text">{{query_label}}</span>
    </div>
    <div class="ykphone-search-header"></div>
    {{/if}}
    {{#if is_dms}}
    <div class="ykphone-split-search">
        <i class="zulip-icon zulip-icon-search ykphone-split-search-icon" aria-hidden="true"></i>
        <input type="text" class="ykphone-split-search-input" placeholder="{{t 'Find people…' }}" aria-label="{{t 'Find people…' }}" autocomplete="off" />
    </div>
    {{/if}}
    {{#if has_tabs}}
    <nav class="ykphone-activity-tabs" aria-label="{{tabs_label}}">
        {{#each tabs}}
            <a class="ykphone-activity-tab{{#if active}} active{{/if}}" href="{{url}}" {{#if active}}aria-current="page"{{/if}}>{{label}}{{#if count}} <span class="ykphone-activity-tab-count">{{count}}</span>{{/if}}</a>
        {{/each}}
    </nav>
    {{/if}}
    {{#if is_activity}}
    <div class="ykphone-activity-toolbar">
        <label class="ykphone-activity-unread-toggle">
            <input type="checkbox" class="ykphone-activity-unread-only" role="switch" {{#if unread_only}}checked{{/if}} />
            <span>{{t 'Unread only' }}</span>
        </label>
        {{#if can_mark_all_read}}
        <button type="button" class="ykphone-activity-mark-all">{{t 'Mark all as read' }}</button>
        {{/if}}
    </div>
    {{/if}}
    <div class="ykphone-split-list-body"></div>
</div>
