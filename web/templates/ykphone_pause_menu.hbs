{{! The pause menu (the 옆커폰 fork): Slack's presets, a custom time,
resuming when paused, and the notification schedule in the settings. }}
<div class="popover-menu ykphone-pause-menu" data-simplebar data-simplebar-tab-index="-1">
    <ul role="menu" class="popover-menu-list">
        {{#if state_label}}
        <li role="none" class="text-item popover-menu-list-item ykphone-pause-menu-current">
            <span class="popover-menu-label">{{state_label}}</span>
        </li>
        <li role="separator" class="popover-menu-separator"></li>
        {{/if}}
        <li role="none" class="text-item popover-menu-list-item ykphone-pause-menu-heading">
            <span class="popover-menu-label">{{t "Pause notifications for…" }}</span>
        </li>
        {{#each presets}}
        <li role="none" class="link-item popover-menu-list-item">
            <a role="menuitem" class="ykphone-pause-preset popover-menu-link" data-ykphone-preset="{{id}}" tabindex="0">
                <span class="popover-menu-label">{{text}}</span>
                {{#if hint}}<span class="ykphone-pause-menu-hint">{{hint}}</span>{{/if}}
            </a>
        </li>
        {{/each}}
        <li role="none" class="link-item popover-menu-list-item">
            <a role="menuitem" class="ykphone-pause-custom popover-menu-link" tabindex="0">
                <span class="popover-menu-label">{{t "Custom time" }}</span>
            </a>
        </li>
        {{#if can_resume}}
        <li role="none" class="link-item popover-menu-list-item">
            <a role="menuitem" class="ykphone-pause-resume popover-menu-link" tabindex="0">
                <span class="popover-menu-label">{{t "Resume notifications" }}</span>
            </a>
        </li>
        {{/if}}
        {{#if has_schedule_settings}}
        <li role="separator" class="popover-menu-separator"></li>
        <li role="none" class="link-item popover-menu-list-item">
            <a role="menuitem" href="#settings/notifications" class="ykphone-pause-schedule popover-menu-link navigate-link-on-enter" tabindex="0">
                <span class="popover-menu-label">{{t "Set a notification schedule…" }}</span>
            </a>
        </li>
        {{/if}}
    </ul>
</div>
