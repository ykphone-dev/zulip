<button type="button" class="ykphone-thread-pill" data-topic-name="{{topic_name}}" aria-label="{{t 'Open thread' }}">
    <i class="zulip-icon zulip-icon-threads" aria-hidden="true"></i>
    <span class="ykphone-thread-pill-count">{{reply_label}}</span>
    {{#if last_reply_label}}
    <span class="ykphone-thread-pill-time">{{last_reply_label}}</span>
    {{/if}}
</button>
