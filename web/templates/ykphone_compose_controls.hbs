{{! Extra compose controls for the two-row layout: the formatting toggle and a mention button. }}
<div class="compose_control_button_container preview_mode_disabled compose_button_tooltip ykphone-compose-formatting-toggle-container" data-tippy-content="{{t 'Formatting' }}">
    <a role="button" class="compose_control_button zulip-icon zulip-icon-type-big ykphone-compose-formatting-toggle" aria-label="{{t 'Formatting' }}" aria-pressed="true" tabindex=0></a>
</div>
<div class="compose_control_button_container preview_mode_disabled disable-on-invalid-recipient compose_button_tooltip ykphone-compose-mention-container" data-tippy-content="{{t 'Mention someone' }}">
    <a role="button" class="compose_control_button zulip-icon zulip-icon-at-sign ykphone-compose-mention" aria-label="{{t 'Mention someone' }}" tabindex=0></a>
</div>
